# Keep the build context small and, critically, prevent `COPY . .` from
# clobbering the alpine node_modules that `npm ci` just installed with the
# host's (wrong-platform) ones.
node_modules
dist
dist-ssr

.git
.gitignore

# Local secrets / config — never bake into the image.
.env
.env.*

# Audio sources. `public/audio/*.m4a` is what ships; these are the 6.2 MB of
# WAV they are encoded from, and only `npm run encode:audio` ever reads them.
audio-src

# Logs, editor, OS cruft
*.log
npm-debug.log*
.vscode
.idea
.DS_Store

# Docker files themselves
Dockerfile
.dockerignore
