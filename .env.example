# Web client configuration. Copy to `.env` and fill in.
#
# Everything here is PUBLIC — Vite inlines `VITE_`-prefixed values into the
# bundle at build time. Firebase Web config is designed to be public (access is
# controlled by Firebase security rules and the authorized-domains list), but
# never add a service-account key or any other secret to this file.

# The Node backend (bingo-node). Used for both the REST calls and the
# Socket.IO connection — they share one port.
VITE_API_BASE_URL=http://localhost:3000

# Firebase Web app config — Firebase Console → Project settings → General →
# Your apps → Web app. Must be the SAME project the mobile app uses, or web
# and mobile users end up in separate user pools.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
